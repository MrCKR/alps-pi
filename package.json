{
  "name": "alps-pi",
  "version": "0.1.1",
  "type": "module",
  "description": "Personal pi beautification extension with runtime TUI message frames, fixed bottom input, animations, and theme support.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrCKR/alps-pi.git"
  },
  "bugs": {
    "url": "https://github.com/MrCKR/alps-pi/issues"
  },
  "homepage": "https://github.com/MrCKR/alps-pi#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "tui"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "themes",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types test/**/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.75.5 <0.76.0",
    "@earendil-works/pi-tui": ">=0.75.5 <0.76.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5"
  }
}
