{
  "name": "alps-pi",
  "version": "0.3.0",
  "type": "module",
  "description": "Personal Pi 0.84.4+ TUI beautification extension with message frames, input styling, animations, and theme support.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrCKR/alps-pi.git"
  },
  "bugs": {
    "url": "https://github.com/MrCKR/alps-pi/issues"
  },
  "homepage": "https://github.com/MrCKR/alps-pi#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-theme",
    "tui"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "themes",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  }
}
